# Copy to backend/.env and fill in. Never commit backend/.env.

# Supabase -> Project Settings -> Database -> Connection string -> **Session pooler** (port 5432).
#  - Do NOT use the Transaction pooler (port 6543): asyncpg prepared statements break there.
#  - The "Direct connection" (db.<ref>.supabase.co) is IPv6-only on the free tier and may not be reachable.
#  - Percent-encode special characters in the password: @ -> %40, # -> %23, / -> %2F, : -> %3A.
#  - postgresql:// is fine; it is converted to postgresql+asyncpg:// and SSL is required automatically.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: a SECOND Supabase project used only by `make test-db` and CI. Never your dev database.
# TEST_DATABASE_URL=postgresql://postgres.<test-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> API. Same project as DATABASE_URL.
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret (service_role / secret key): server only, never in the frontend or logs.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Optional, legacy projects only (HS256 "JWT secret"). Leave unset to verify tokens with the project's JWKS.
# SUPABASE_JWT_SECRET=

# Public URL of the web app (invite and password-reset links redirect here).
APP_URL=http://localhost:5173

# development | test | production
ENVIRONMENT=development

# Comma-separated. Empty in dev: the Vite dev server proxies /api to the API.
CORS_ORIGINS=

# Kept small: the Supabase pooler caps connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
