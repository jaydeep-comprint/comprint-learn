# Prefix for API calls in deployed builds. Empty = same origin (dev uses the Vite /api proxy).
VITE_API_BASE_URL=

# Supabase -> Project Settings -> API: project URL and the anon / publishable key (safe for the browser).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
